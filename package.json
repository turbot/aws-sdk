{
  "name": "@turbot/aws-sdk",
  "author": "Turbot HQ, Inc",
  "description": "Turbot aws-sdk wrapper.",
  "version": "5.16.0",
  "license": "Apache-2.0",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/turbot/aws-sdk.git"
  },
  "scripts": {
    "coverage": "npx nyc npm test",
    "test": "npx mocha 'test/index.js' 'test/*-proxy.test.js' 'test/*-connect.test.js'",
    "test:integration": "npx mocha test/integration/**/*.test.js",
    "test:integration:s3": "npx mocha test/integration/s3.test.js test/integration/turbot-core-patterns.test.js",
    "test:integration:ssm": "npx mocha test/integration/ssm.test.js test/integration/turbot-core-ssm-patterns.test.js",
    "test:integration:sts": "npx mocha test/integration/sts.test.js test/integration/turbot-core-sts-patterns.test.js",
    "test:integration:kms": "npx mocha test/integration/kms.test.js test/integration/turbot-core-kms-patterns.test.js",
    "test:integration:sns": "npx mocha test/integration/sns.test.js test/integration/turbot-core-sns-patterns.test.js",
    "test:integration:lambda": "npx mocha test/integration/lambda.test.js test/integration/turbot-core-lambda-patterns.test.js",
    "format": "npx prettier --write \"index.js\" \"lib/**/*.js\" \"test/**/*.js\""
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.969.0",
    "@aws-sdk/client-cloudwatch": "^3.969.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.969.0",
    "@aws-sdk/client-ec2": "^3.969.0",
    "@aws-sdk/client-ecs": "^3.968.0",
    "@aws-sdk/client-elasticache": "^3.968.0",
    "@aws-sdk/client-iam": "^3.968.0",
    "@aws-sdk/client-kms": "^3.968.0",
    "@aws-sdk/client-lambda": "^3.968.0",
    "@aws-sdk/client-rds": "^3.968.0",
    "@aws-sdk/client-s3": "3.968.0",
    "@aws-sdk/client-s3-control": "^3.969.0",
    "@aws-sdk/client-ses": "^3.968.0",
    "@aws-sdk/client-sns": "^3.968.0",
    "@aws-sdk/client-sqs": "^3.968.0",
    "@aws-sdk/client-ssm": "^3.968.0",
    "@aws-sdk/client-sts": "^3.968.0",
    "@aws-sdk/lib-storage": "3.968.0",
    "@aws-sdk/rds-signer": "^3.968.0",
    "@aws-sdk/s3-request-presigner": "3.968.0",
    "@turbot/errors": "5.3.0",
    "@turbot/log": "5.5.0",
    "aws-sdk": "2.1685",
    "aws4": "1.13.2",
    "https-proxy-agent": "^5.0.0",
    "lodash": "^4.17.21",
    "micromatch": "4.0.8"
  },
  "devDependencies": {
    "@aws-sdk/credential-providers": "3.968.0",
    "chai": "4.3.10",
    "eslint": "7.28.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "3.4.0",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.12.0",
    "mocha": "^10.0.0",
    "nyc": "^15.1.0",
    "prettier": "2.3.1",
    "test-console": "1.1.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:prettier/recommended",
      "eslint:recommended",
      "plugin:you-dont-need-lodash-underscore/compatible"
    ],
    "env": {
      "es6": true,
      "node": true,
      "mocha": true
    },
    "parserOptions": {
      "ecmaVersion": 10
    },
    "rules": {
      "no-console": "off",
      "you-dont-need-lodash-underscore/is-nil": "off"
    }
  },
  "prettier": {
    "printWidth": 120
  }
}
